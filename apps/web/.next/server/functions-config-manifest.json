{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!api|_next\\/static|_next\\/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|webp|ico)$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!api|_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|webp|ico)$).*)"
        }
      ]
    },
    "/api/connect/[platform]": {},
    "/api/editor-draft": {},
    "/api/ffmpeg/logo": {
      "maxDuration": 60
    },
    "/api/instagram/auth": {},
    "/api/instagram/callback": {},
    "/api/instagram/media/[id]": {},
    "/api/superadmin/users/[id]/reset-access": {},
    "/api/whapi/media/[id]": {},
    "/api/whatsapp/groups": {},
    "/api/whatsapp/groups/[groupId]": {},
    "/api/whatsapp/groups/[groupId]/invite-link": {},
    "/api/whatsapp/groups/[groupId]/message": {},
    "/api/whatsapp/groups/[groupId]/participants": {},
    "/api/whatsapp/publish": {},
    "/api/whatsapp/send-message": {}
  }
}