# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# server-side OAuth token vault (never commit)
/linkedin-tokens.json
/facebook-tokens.json

# Canva Connect API session store - short-lived correlation ids only (no
# tokens live here), but it's local transient state, not project source.
/canva-sessions.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
