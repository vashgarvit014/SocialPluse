# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Root-anchored above only covers the repo root — apps/web and
# apps/superadmin each have their own node_modules once `npm install`
# runs there. Unanchored so it matches at any depth.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Unanchored on purpose: `/.next/` only ever matched the repo-root .next, so
# apps/web/.next and apps/superadmin/.next stayed tracked and every build
# churned ~200 committed artefact files.
.next/
**/.next/
/out/
**/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# server-side OAuth token vault (never commit)
/linkedin-tokens.json
/facebook-tokens.json

# Canva Connect API session store - short-lived correlation ids only (no
# tokens live here), but it's local transient state, not project source.
/canva-sessions.json

# WhatsApp webhook event log - local inspection log, not project source.
/whatsapp-events.log

# Local dev-server output and long-running helper event logs. Runtime noise:
# they are machine-specific, grow without bound, and carry no project state.
/dev-server.log
/whapi-events.log

# Auth database — legacy SQLite-era files, no longer created (PostgreSQL now,
# see docker-compose.yml's "db" service + src/lib/db.ts), left ignored in
# case an old one still exists on a host from before this migration.
/socialpulse.db
/socialpulse.db-wal
/socialpulse.db-shm

# PostgreSQL backups (pg_dump output) - contain password hashes, never commit.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary Instagram publishing media
/.instagram-media/
# Persistent Asset Gallery uploads (bytes on disk, metadata in Postgres)
# - never committed: user content, not source
/.media-assets/
